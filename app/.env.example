# Perso réaliste à ton image, gratuit : compte Hugging Face → Settings → Access Tokens → New token (Read). Colle-le ici puis relance LANCER-FITAIA.
EXPO_PUBLIC_HF_TOKEN=
# Modèle (optionnel) : black-forest-labs/FLUX.1-schnell par défaut
EXPO_PUBLIC_HF_MODEL=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optionnel — génération d'icône par IA (jamais en dur dans le code). Le dessin d'avatar passe par le serveur (secrets Supabase), pas par l'app.
OPENAI_API_KEY=
# Serveur de dessin d'avatar (Supabase Edge Function `avatar`) — voir supabase/README.md
EXPO_PUBLIC_AVATAR_ENDPOINT=
# Serveur « selfie → avatar 3D » (hero3d/human/code/serve_avatar.py, lancé par SERVEUR-AVATAR.bat). Sur iPhone : http://<IP du PC>:8790
EXPO_PUBLIC_AVATAR3D_ENDPOINT=
# Jeton partagé avec le serveur (variable FITAIA_AVATAR_TOKEN côté serveur), facultatif en local
EXPO_PUBLIC_AVATAR3D_TOKEN=
# Serveur « selfie → perso caricature » (hero3d/caricature/serve_caricature.py, lancé par SERVEUR-CARICATURE.bat). Sur iPhone : http://<IP du PC>:8791
EXPO_PUBLIC_CARICATURE_ENDPOINT=
EXPO_PUBLIC_CARICATURE_TOKEN=
