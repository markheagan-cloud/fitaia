# Perso réaliste à ton image, gratuit : compte Hugging Face → Settings → Access Tokens → New token (Read). Colle-le ici puis relance LANCER-FITAIA.
EXPO_PUBLIC_HF_TOKEN=
# Modèle (optionnel) : black-forest-labs/FLUX.1-schnell par défaut
EXPO_PUBLIC_HF_MODEL=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optionnel — génération d'icône par IA (jamais en dur dans le code). Le dessin d'avatar passe par le serveur (secrets Supabase), pas par l'app.
OPENAI_API_KEY=
# Serveur de dessin d'avatar (Supabase Edge Function `avatar`) — voir supabase/README.md
EXPO_PUBLIC_AVATAR_ENDPOINT=
