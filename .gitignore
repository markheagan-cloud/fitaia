# --- Usine 3D : on garde le code, pas les rendus ni les modèles ---
/hero3d/**
!/hero3d/**/
!/hero3d/**/*.py
!/hero3d/**/*.md
!/hero3d/**/*.bat
!/hero3d/**/*.ps1
!/hero3d/**/*.txt
# serveur caricature : les workflows ComfyUI (JSON) font partie du code, pas les sorties
!/hero3d/caricature/workflows/*.json
/hero3d/caricature/out/
__pycache__/

# --- Teaser Remotion : code seulement ---
/teaser/**/node_modules/
/teaser/**/out/
/teaser/**/*.mp4
/teaser/**/*.mov

